              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a catalog item."
        },
        {
          "info": {
            "name": "Delete a catalog item.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.invoiced.com/items/:id",
            "params": [
