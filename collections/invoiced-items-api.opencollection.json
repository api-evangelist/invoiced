                "description": "The page number for paginated list responses."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "The number of records to return per page (max 100)."
              }
            ]
          },
          "docs": "List all catalog items."
        },
        {
          "info": {
            "name": "Create a new catalog item.",
