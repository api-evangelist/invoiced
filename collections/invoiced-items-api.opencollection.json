{
  "opencollection": "1.0.0",
  "info": {
    "name": "Invoiced Credit Notes Items API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Items",
